# Server
NODE_ENV=development
PORT=3000

# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# Nodemailer
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=
TWILIO_STATUS_CALLBACK=
TWILIO_VOICE_STATUS_CALLBACK=
TWILIO_VOICE_URL=

# OTP Security
OTP_MAX_VALIDATE_ATTEMPTS=5
OTP_VALIDATE_ATTEMPTS_TTL_SECONDS=900
OTP_GENERATE_RATE_LIMIT_MAX_REQUESTS=3
OTP_GENERATE_RATE_LIMIT_WINDOW_SECONDS=60